<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!-- Plantillas 1 (Cronograma) y 2 (Operario): comparten head/estilos -->
    <!-- ================================================================ -->
    <template id="kiosk_page" name="TV Calendar Kiosk">
        <html t-att-lang="'es'">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <t t-if="refresh_interval and refresh_interval &gt; 0">
                    <meta http-equiv="refresh" t-att-content="refresh_interval"/>
                </t>
                <title t-esc="board.name"/>
                <style>
                    :root {
                        --bg: #eef1f5; --panel: #ffffff; --ink: #1a2233;
                        --muted: #7a8699; --grid-line: #d5dbe4; --today: #0b57d0;
                        --header-bg: #0b1f3a; --header-ink: #ffffff;
                        --out-month: #f4f6f9; --weekend: #f7f9fc; --accent: #0b57d0;
                    }
                    body.theme-dark {
                        --bg: #0c1220; --panel: #131c2e; --ink: #eef2f8;
                        --muted: #93a1b8; --grid-line: #26324a; --today: #4f8cff;
                        --header-bg: #050b16; --header-ink: #ffffff;
                        --out-month: #0e1626; --weekend: #101a2c; --accent: #4f8cff;
                    }
                    * { box-sizing: border-box; margin: 0; padding: 0; }
                    html, body { height: 100%; }
                    body {
                        background: var(--bg); color: var(--ink);
                        font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                        height: 100vh; display: flex; flex-direction: column;
                        overflow: hidden; -webkit-font-smoothing: antialiased;
                    }
                    header.tvc-header {
                        background: var(--header-bg); color: var(--header-ink);
                        display: flex; align-items: center; justify-content: space-between;
                        padding: 1.2vh 2vw; flex: 0 0 auto; gap: 1vw;
                    }
                    .tvc-title { display: flex; align-items: baseline; gap: 1.2vw; flex-wrap: wrap; }
                    .tvc-month { font-size: clamp(22px, 3.2vw, 54px); font-weight: 800; }
                    .tvc-year { font-size: clamp(16px, 1.8vw, 30px); font-weight: 400; opacity: .7; }
                    .tvc-board { font-size: clamp(13px, 1.3vw, 22px); opacity: .8; }
                    .tvc-right { display: flex; gap: 1.4vw; align-items: center; flex-wrap: wrap; }
                    .tvc-legend { display: flex; gap: 1.2vw; align-items: center; flex-wrap: wrap; }
                    .tvc-legend .item { display: flex; align-items: center; gap: .5vw; font-size: clamp(12px, 1.1vw, 20px); }
                    .tvc-legend .dot { width: 1.1vw; height: 1.1vw; min-width: 12px; min-height: 12px; border-radius: 50%; }
                    .tvc-legend .cnt { font-weight: 700; }
                    .tvc-clock { font-size: clamp(20px, 2.2vw, 44px); font-weight: 800; opacity: 1; white-space: nowrap; font-variant-numeric: tabular-nums; }
                    .op-chip {
                        background: var(--accent); color: #fff; font-weight: 800;
                        padding: .5vh 1.1vw; border-radius: 999px;
                        font-size: clamp(15px, 1.6vw, 30px); white-space: nowrap;
                    }

                    /* -------- Cronograma -------- */
                    .tvc-weekdays { display: grid; gap: 2px; padding: 4px 4px 0 4px; flex: 0 0 auto; }
                    .tvc-weekdays .wd {
                        text-align: center; font-size: clamp(12px, 1.3vw, 24px);
                        font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
                        color: var(--muted); padding: .6vh 0;
                    }
                    .tvc-grid { display: grid; gap: 2px; padding: 0 4px 4px 4px; flex: 1 1 auto; min-height: 0; }
                    .tvc-cell {
                        background: var(--panel); border: 1px solid var(--grid-line);
                        border-radius: 8px; padding: .5vh .5vw; display: flex;
                        flex-direction: column; min-height: 0; overflow: hidden;
                    }
                    .tvc-cell.out { background: var(--out-month); }
                    .tvc-cell.out .daynum { opacity: .35; }
                    .tvc-cell.weekend { background: var(--weekend); }
                    .tvc-cell.today { border-color: var(--today); box-shadow: inset 0 0 0 3px var(--today); }
                    .tvc-cell .daynum {
                        font-size: clamp(15px, 1.6vw, 30px); font-weight: 700; line-height: 1;
                        margin-bottom: .4vh; display: flex; justify-content: space-between; align-items: baseline;
                    }
                    .tvc-cell .daynum .wd { font-size: clamp(11px, 1vw, 20px); font-weight: 700; color: var(--muted); text-transform: uppercase; }
                    .tvc-cell.today .daynum { color: var(--today); }
                    .tvc-cell.today .daynum .wd { color: var(--today); }
                    .tvc-cell .daynum .badge { background: var(--today); color: #fff; border-radius: 999px; padding: .2vh .8vw; }
                    .tvc-tasks { display: flex; flex-direction: column; gap: .5vh; overflow: hidden; }
                    .tvc-task {
                        color: #fff; border-radius: 6px; padding: .5vh .7vw;
                        line-height: 1.2; overflow: hidden;
                    }
                    .tvc-task .t-time { font-size: clamp(9px, .85vw, 16px); font-weight: 600; opacity: .85; white-space: nowrap; display: block; }
                    .tvc-task .t-name {
                        font-size: clamp(12px, 1.2vw, 24px); font-weight: 800; margin-top: .1vh;
                        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
                    }
                    .tvc-task .t-name .check { margin-right: .3vw; }
                    .tvc-task .t-boards { font-size: clamp(9px, .85vw, 16px); font-weight: 700; opacity: .95; margin-top: .15vh; }
                    .tvc-task .t-boards .bd { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
                    .tvc-task .t-desc {
                        font-size: clamp(10px, .9vw, 17px); font-weight: 400; opacity: .95; margin-top: .2vh;
                        white-space: pre-line; overflow: hidden;
                        display: -webkit-box; -webkit-line-clamp: 10; -webkit-box-orient: vertical;
                    }
                    .tvc-task.done { opacity: .55; text-decoration: line-through; }
                    .tvc-task .check { font-weight: 800; }
                    .tvc-overflow { font-size: clamp(11px, 1vw, 18px); font-weight: 700; color: var(--muted); padding-left: .3vw; }

                    /* Dia actual (extendido): tarea dividida 70% / 30% */
                    .tvc-task.tvc-split { display: flex; flex-direction: row; gap: .7vw; align-items: stretch; }
                    .tvc-split .ts-main { flex: 0 0 70%; max-width: 70%; min-width: 0; }
                    .tvc-split .ts-side { flex: 0 0 30%; max-width: 30%; min-width: 0;
                        border-left: 2px solid rgba(255,255,255,.35); padding-left: .6vw; }
                    .tvc-split .ts-side .t-time { display: block; margin-bottom: .3vh; }
                    .tvc-split .ts-side .t-boards { margin-top: 0; }
                    .tvc-split .ts-main .t-desc { -webkit-line-clamp: 10; }

                    /* Dia Extendido: fuente de tareas mas pequena (TV 55") */
                    .tvc-grid.ext .tvc-task { padding: .35vh .5vw; }
                    .tvc-grid.ext .tvc-task .t-time { font-size: clamp(8px, .7vw, 13px); }
                    .tvc-grid.ext .tvc-task .t-name { font-size: clamp(10px, .95vw, 18px); }
                    .tvc-grid.ext .tvc-task .t-boards { font-size: clamp(8px, .72vw, 13px); }
                    .tvc-grid.ext .tvc-task .t-desc { font-size: clamp(9px, .78vw, 14px); -webkit-line-clamp: 6; }
                    .tvc-grid.ext .tvc-cell .daynum { font-size: clamp(13px, 1.3vw, 24px); }
                    .tvc-grid.ext .tvc-cell .daynum .wd { font-size: clamp(10px, .95vw, 18px); }

                    /* -------- Operario -------- */
                    .op-main { flex: 1 1 auto; display: flex; min-height: 0; gap: 6px; padding: 6px; }

                    /* Panel grande (70%): TAREAS DE HOY */
                    .op-primary { flex: 7 1 0; min-width: 0; display: flex; flex-direction: column;
                        background: var(--panel); border: 1px solid var(--grid-line); border-radius: 10px; overflow: hidden; }
                    .op-caption { background: var(--accent); color: #fff; padding: .9vh 1.4vw; flex: 0 0 auto;
                        font-size: clamp(16px, 1.9vw, 34px); font-weight: 800; letter-spacing: .5px; }
                    .big-tasks { flex: 1 1 auto; display: flex; flex-direction: column; gap: 1vh; padding: 1.2vh 1.2vw; overflow: auto; }
                    .big-task { color: #fff; border-radius: 12px; padding: 1.4vh 1.4vw; display: flex; flex-direction: row; gap: 1.2vw; align-items: stretch; }
                    .big-task .bt-content { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: .3vh; }
                    .big-task .bt-img { flex: 0 0 40%; display: flex; align-items: center; justify-content: center; }
                    .big-task .bt-img img { max-width: 100%; max-height: 34vh; border-radius: 8px; object-fit: contain; background: #fff; }
                    .big-task.done { opacity: .55; text-decoration: line-through; }
                    .big-task .bt-time { font-size: clamp(12px, 1.3vw, 26px); font-weight: 600; opacity: .85; white-space: nowrap; }
                    .big-task .bt-name { font-size: clamp(20px, 2.6vw, 52px); font-weight: 800; line-height: 1.1; margin-top: .2vh; }
                    .big-task .bt-desc { font-size: clamp(14px, 1.5vw, 30px); font-weight: 500; opacity: .95;
                        overflow: hidden; display: -webkit-box; -webkit-line-clamp: 10; -webkit-box-orient: vertical; }
                    .big-task .bt-desc p { margin: 0 0 .3em 0; }
                    .big-task .bt-desc p:last-child { margin-bottom: 0; }
                    .big-task .bt-desc img { max-width: 100%; max-height: 22vh; height: auto; border-radius: 6px; margin: .3em 0; }
                    .big-task .bt-desc a { color: #fff; text-decoration: underline; }
                    .big-empty { color: var(--muted); padding: 4vh 1.5vw; text-align: center; font-size: clamp(18px, 2vw, 38px); }

                    /* Panel estrecho (30%): seguridad + horario + avisos */
                    .op-secondary { flex: 3 1 0; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
                    .op-epp { background: #d32f2f; color: #fff; border-radius: 10px; padding: 1vh 1vw; flex: 0 0 auto;
                        display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: .4vh; }
                    .op-epp .icon { font-size: clamp(22px, 2.8vw, 44px); line-height: 1; }
                    .op-epp .txt { font-size: clamp(13px, 1.4vw, 26px); font-weight: 800; }
                    .op-ban2 { background: #212b3a; border: 2px solid #d32f2f; color: #fff; border-radius: 10px;
                        padding: .8vh 1vw; display: flex; align-items: center; justify-content: center; gap: .6vw; text-align: center; flex: 0 0 auto; }
                    .op-ban2 .icon { font-size: clamp(20px, 2.4vw, 38px); line-height: 1; }
                    .op-ban2 .txt { font-size: clamp(12px, 1.3vw, 24px); font-weight: 800; }
                    .op-sched { background: var(--panel); border: 1px solid var(--grid-line); border-radius: 10px;
                        flex: 1 1 0; display: flex; flex-direction: column; overflow: hidden; }
                    .op-sched .s-cap { background: var(--header-bg); color: #fff; padding: .6vh 1vw;
                        font-size: clamp(12px, 1.3vw, 22px); font-weight: 800; letter-spacing: .5px; flex: 0 0 auto; }
                    .op-sched .s-rows { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
                    .s-row { flex: 1 1 0; display: flex; align-items: center; gap: .6vw; padding: 0 .8vw;
                        border-bottom: 1px solid var(--grid-line); min-height: 0; }
                    .s-row:last-child { border-bottom: 0; }
                    .s-time { flex: 0 0 34%; font-size: clamp(12px, 1.2vw, 22px); font-weight: 800;
                        color: var(--accent); font-variant-numeric: tabular-nums; }
                    .s-act { flex: 1 1 auto; font-size: clamp(11px, 1.1vw, 20px); font-weight: 700;
                        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
                    .s-act.pill { color: #fff; border-radius: 6px; padding: .3vh .6vw; }
                    .op-notice { background: var(--panel); border: 1px solid var(--grid-line); border-radius: 10px;
                        flex: 0 0 auto; max-height: 26vh; display: flex; flex-direction: column; overflow: hidden; }
                    .op-notice .n-title { background: #f9a825; color: #1a2233; padding: .6vh 1vw;
                        font-size: clamp(12px, 1.3vw, 22px); font-weight: 800; letter-spacing: .5px; flex: 0 0 auto; }
                    .op-notice .n-body { padding: .8vh 1vw; font-size: clamp(12px, 1.2vw, 22px); font-weight: 600;
                        white-space: pre-wrap; overflow: auto; line-height: 1.3; }
                    .op-notice .n-empty { color: var(--muted); font-weight: 400; }

                    /* Mecanizado: horario compacto -> mas espacio para AVISOS */
                    .op-mecan .op-sched { flex: 0 0 auto; }
                    .op-mecan .op-sched .s-rows { flex: 0 0 auto; }
                    .op-mecan .s-row { flex: 0 0 auto; padding: .1vh .8vw; }
                    .op-mecan .s-time { font-size: clamp(10px, 1vw, 18px); }
                    .op-mecan .s-act { font-size: clamp(10px, .95vw, 17px); }
                    .op-mecan .s-act.pill { padding: .2vh .5vw; }
                    .op-mecan .op-notice { flex: 1 1 auto; max-height: none; }
                    .op-mecan .op-notice .n-body { font-size: clamp(14px, 1.5vw, 28px); }
                </style>
            </head>
            <body t-attf-class="theme-#{theme}">
                <t t-if="template_type in ('operator', 'mecanizado')">
                    <!-- ================= OPERARIO / MECANIZADO ================= -->
                    <header class="tvc-header">
                        <div class="tvc-title">
                            <span class="tvc-month" t-esc="month_name"/>
                            <span class="tvc-year" t-esc="year"/>
                            <span class="tvc-board" t-esc="board.name"/>
                        </div>
                        <div class="tvc-right">
                            <t t-if="operator_name">
                                <span class="op-chip">Operario: <t t-esc="operator_name"/></span>
                            </t>
                            <span class="tvc-clock" id="tvc-clock" t-esc="now_label"/>
                        </div>
                    </header>
                    <div t-attf-class="op-main#{' op-mecan' if is_mecan else ''}">
                        <div class="op-primary">
                            <div class="op-caption">TAREAS DE HOY — <t t-esc="today_label"/></div>
                            <div class="big-tasks">
                                <t t-foreach="today_tasks" t-as="task">
                                    <div t-attf-class="big-task#{' done' if task['done'] else ''}"
                                         t-attf-style="background:#{task['color']}">
                                        <div class="bt-content">
                                            <t t-if="task['created_ts']">
                                                <div class="bt-time" t-att-data-ts="task['created_ts']"/>
                                            </t>
                                            <div class="bt-name" t-esc="task['name']"/>
                                            <t t-if="task['description_text']">
                                                <div class="bt-desc" t-out="task['description_html']"/>
                                            </t>
                                        </div>
                                        <t t-if="show_images and task['image']">
                                            <div class="bt-img"><img t-att-src="task['image']"/></div>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="not today_tasks">
                                    <div class="big-empty">Sin tareas para hoy.</div>
                                </t>
                            </div>
                        </div>
                        <div class="op-secondary">
                            <div class="op-epp">
                                <div class="icon">&#9888;</div>
                                <div class="txt" t-esc="epp_message"/>
                            </div>
                            <t t-if="epp_message2">
                                <div class="op-ban2">
                                    <div class="icon">&#128683;</div>
                                    <div class="txt" t-esc="epp_message2"/>
                                </div>
                            </t>
                            <div class="op-sched">
                                <div class="s-cap">HORARIO DEL DIA — <t t-esc="today_label"/></div>
                                <div class="s-rows">
                                    <t t-foreach="slots" t-as="slot">
                                        <div class="s-row">
                                            <div class="s-time" t-esc="slot['time']"/>
                                            <t t-if="slot['activity']">
                                                <div class="s-act pill" t-attf-style="background:#{slot['color']}"
                                                     t-esc="slot['activity']"/>
                                            </t>
                                            <t t-else="">
                                                <div class="s-act" style="opacity:.35">—</div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="not slots">
                                        <div class="s-row"><div class="s-act" style="opacity:.5">
                                            Sin horario. Usa "Cargar horario estandar".
                                        </div></div>
                                    </t>
                                </div>
                            </div>
                            <div class="op-notice">
                                <div class="n-title">AVISOS</div>
                                <t t-if="notice_message">
                                    <div class="n-body" t-esc="notice_message"/>
                                </t>
                                <t t-else="">
                                    <div class="n-body n-empty">Sin avisos.</div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <!-- ======================= CRONOGRAMA ======================= -->
                    <header class="tvc-header">
                        <div class="tvc-title">
                            <span class="tvc-month" t-esc="month_name"/>
                            <span class="tvc-year" t-esc="year"/>
                            <span class="tvc-board" t-esc="board.name"/>
                        </div>
                        <div class="tvc-right">
                            <div class="tvc-legend">
                                <t t-foreach="legend" t-as="lg">
                                    <div class="item">
                                        <span class="dot" t-attf-style="background:#{lg['color']}"/>
                                        <span t-esc="lg['label']"/>
                                        <span class="cnt" t-esc="lg['count']"/>
                                    </div>
                                </t>
                            </div>
                            <span class="tvc-clock" id="tvc-clock" t-esc="now_label"/>
                        </div>
                    </header>
                    <t t-if="show_weekdays_row">
                        <div class="tvc-weekdays" t-attf-style="grid-template-columns: repeat(#{num_columns}, 1fr);">
                            <t t-foreach="weekday_names" t-as="wd">
                                <div class="wd" t-esc="wd"/>
                            </t>
                        </div>
                    </t>
                    <div t-attf-class="tvc-grid#{' ext' if extended else ''}"
                         t-attf-style="grid-template-columns: repeat(#{num_columns}, 1fr); grid-template-rows: repeat(#{len(weeks)}, 1fr);">
                        <t t-foreach="weeks" t-as="week">
                            <t t-foreach="week" t-as="day">
                                <div t-attf-class="tvc-cell#{' out' if not day['in_month'] else ''}#{' today' if day['is_today'] else ''}#{' weekend' if day['is_weekend'] else ''}"
                                     t-attf-style="grid-column: span #{day['span']};">
                                    <div class="daynum">
                                        <t t-if="not show_weekdays_row">
                                            <span class="wd" t-esc="day['weekday_label']"/>
                                        </t>
                                        <t t-if="day['is_today']"><span class="badge" t-esc="day['day_num']"/></t>
                                        <t t-else=""><span t-esc="day['day_num']"/></t>
                                    </div>
                                    <div class="tvc-tasks">
                                        <t t-foreach="day['tasks']" t-as="task">
                                            <div t-attf-class="tvc-task#{' tvc-split' if day['split'] else ''}#{' done' if task['done'] else ''}"
                                                 t-attf-style="background:#{task['color']}">
                                                <t t-if="day['split']">
                                                    <!-- Dia actual: 70% titulo+desc / 30% fecha+tableros -->
                                                    <div class="ts-main">
                                                        <div class="t-name">
                                                            <t t-if="task['done']"><span class="check">&#10003;</span></t>
                                                            <t t-esc="task['name']"/>
                                                        </div>
                                                        <t t-if="task['description_text']">
                                                            <div class="t-desc" t-esc="task['description_text']"/>
                                                        </t>
                                                    </div>
                                                    <div class="ts-side">
                                                        <t t-if="task['created_ts']">
                                                            <span class="t-time" t-att-data-ts="task['created_ts']"/>
                                                        </t>
                                                        <t t-if="task['boards']">
                                                            <div class="t-boards">
                                                                <t t-foreach="task['boards']" t-as="bd">
                                                                    <div class="bd">&#9642; <t t-esc="bd"/></div>
                                                                </t>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </t>
                                                <t t-else="">
                                                    <t t-if="task['created_ts']">
                                                        <span class="t-time" t-att-data-ts="task['created_ts']"/>
                                                    </t>
                                                    <div class="t-name">
                                                        <t t-if="task['done']"><span class="check">&#10003;</span></t>
                                                        <t t-esc="task['name']"/>
                                                    </div>
                                                    <t t-if="task['boards']">
                                                        <div class="t-boards">
                                                            <t t-foreach="task['boards']" t-as="bd">
                                                                <div class="bd">&#9642; <t t-esc="bd"/></div>
                                                            </t>
                                                        </div>
                                                    </t>
                                                    <t t-if="day['show_desc'] and task['description_text']">
                                                        <div class="t-desc" t-esc="task['description_text']"/>
                                                    </t>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="day['overflow']">
                                            <div class="tvc-overflow">+<t t-esc="day['overflow']"/> mas</div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </t>

                <script type="text/javascript">
                    (function () {
                        function pad(n) { return (n &lt; 10 ? '0' : '') + n; }
                        function fmtTime(d) {
                            var h = d.getHours();
                            var ap = h &lt; 12 ? 'am' : 'pm';
                            var h12 = h % 12; if (h12 === 0) { h12 = 12; }
                            return pad(h12) + ':' + pad(d.getMinutes()) + ' ' + ap;
                        }
                        // Horas de creacion -> hora local del dispositivo (arregla la zona horaria)
                        var stamps = document.querySelectorAll('[data-ts]');
                        Array.prototype.forEach.call(stamps, function (el) {
                            var ts = parseInt(el.getAttribute('data-ts'), 10);
                            if (ts) {
                                var d = new Date(ts * 1000);
                                el.textContent = pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + ' ' + fmtTime(d);
                            }
                        });
                        // Reloj en vivo
                        var clock = document.getElementById('tvc-clock');
                        if (clock) {
                            function tick() {
                                var d = new Date();
                                clock.textContent = pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' +
                                    d.getFullYear() + ' ' + fmtTime(d);
                            }
                            tick(); setInterval(tick, 15000);
                        }
                    })();
                </script>
            </body>
        </html>
    </template>

    <!-- ================================================================ -->
    <!-- Plantilla 3: Publicidad (playlist de YouTube a pantalla completa) -->
    <!-- ================================================================ -->
    <template id="kiosk_ad" name="TV Calendar Ad">
        <html t-att-lang="'es'">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title t-esc="board.name"/>
                <style>
                    * { box-sizing: border-box; margin: 0; padding: 0; }
                    html, body { height: 100%; width: 100%; background: #000; overflow: hidden; }
                    iframe { border: 0; width: 100vw; height: 100vh; display: block; }
                    .ad-empty {
                        color: #fff; height: 100vh; display: flex; align-items: center;
                        justify-content: center; text-align: center; padding: 5vw;
                        font-family: "Segoe UI", Roboto, Arial, sans-serif;
                        font-size: clamp(18px, 2.4vw, 40px); line-height: 1.5;
                    }
                </style>
            </head>
            <body>
                <t t-if="embed_url">
                    <iframe t-att-src="embed_url"
                            allow="autoplay; encrypted-media; fullscreen"
                            allowfullscreen="allowfullscreen"/>
                </t>
                <t t-else="">
                    <div class="ad-empty">
                        <div>
                            <p>Configura la <b>URL de la playlist de YouTube</b> en el tablero.</p>
                            <p style="opacity:.6; font-size:.6em; margin-top:1em;">
                                Debe contener <code>list=...</code> (una lista de reproduccion, no un solo video).
                            </p>
                        </div>
                    </div>
                </t>
            </body>
        </html>
    </template>
</odoo>
