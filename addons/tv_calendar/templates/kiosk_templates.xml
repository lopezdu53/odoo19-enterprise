<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="kiosk_page" name="TV Calendar Kiosk">
        <html t-att-lang="'es'">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <t t-if="refresh_interval and refresh_interval &gt; 0">
                    <meta http-equiv="refresh" t-att-content="refresh_interval"/>
                </t>
                <title t-esc="board.name"/>
                <style>
                    :root {
                        --bg: #eef1f5;
                        --panel: #ffffff;
                        --ink: #1a2233;
                        --muted: #7a8699;
                        --grid-line: #d5dbe4;
                        --today: #0b57d0;
                        --header-bg: #0b1f3a;
                        --header-ink: #ffffff;
                        --out-month: #f4f6f9;
                        --weekend: #f7f9fc;
                    }
                    body.theme-dark {
                        --bg: #0c1220;
                        --panel: #131c2e;
                        --ink: #eef2f8;
                        --muted: #93a1b8;
                        --grid-line: #26324a;
                        --today: #4f8cff;
                        --header-bg: #050b16;
                        --header-ink: #ffffff;
                        --out-month: #0e1626;
                        --weekend: #101a2c;
                    }
                    * { box-sizing: border-box; margin: 0; padding: 0; }
                    html, body { height: 100%; }
                    body {
                        background: var(--bg);
                        color: var(--ink);
                        font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                        height: 100vh;
                        display: flex;
                        flex-direction: column;
                        overflow: hidden;
                        -webkit-font-smoothing: antialiased;
                    }
                    header.tvc-header {
                        background: var(--header-bg);
                        color: var(--header-ink);
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        padding: 1.2vh 2vw;
                        flex: 0 0 auto;
                    }
                    .tvc-title { display: flex; align-items: baseline; gap: 1.2vw; }
                    .tvc-month { font-size: clamp(22px, 3.4vw, 56px); font-weight: 800; letter-spacing: .3px; }
                    .tvc-year { font-size: clamp(16px, 1.8vw, 30px); font-weight: 400; opacity: .7; }
                    .tvc-board { font-size: clamp(13px, 1.3vw, 22px); opacity: .8; }
                    .tvc-legend { display: flex; gap: 1.4vw; align-items: center; flex-wrap: wrap; }
                    .tvc-legend .item { display: flex; align-items: center; gap: .5vw; font-size: clamp(12px, 1.1vw, 20px); }
                    .tvc-legend .dot { width: 1.1vw; height: 1.1vw; min-width: 12px; min-height: 12px; border-radius: 50%; }
                    .tvc-legend .cnt { font-weight: 700; }
                    .tvc-clock { font-size: clamp(13px, 1.3vw, 24px); font-weight: 600; opacity: .85; white-space: nowrap; }

                    .tvc-weekdays {
                        display: grid;
                        gap: 2px;
                        padding: 4px 4px 0 4px;
                        flex: 0 0 auto;
                    }
                    .tvc-weekdays .wd {
                        text-align: center;
                        font-size: clamp(12px, 1.3vw, 24px);
                        font-weight: 700;
                        text-transform: uppercase;
                        letter-spacing: .5px;
                        color: var(--muted);
                        padding: .6vh 0;
                    }

                    .tvc-grid {
                        display: grid;
                        gap: 2px;
                        padding: 0 4px 4px 4px;
                        flex: 1 1 auto;
                        min-height: 0;
                    }
                    .tvc-cell {
                        background: var(--panel);
                        border: 1px solid var(--grid-line);
                        border-radius: 8px;
                        padding: .5vh .5vw;
                        display: flex;
                        flex-direction: column;
                        min-height: 0;
                        overflow: hidden;
                    }
                    .tvc-cell.out { background: var(--out-month); }
                    .tvc-cell.out .daynum { opacity: .35; }
                    .tvc-cell.weekend { background: var(--weekend); }
                    .tvc-cell.today {
                        border-color: var(--today);
                        box-shadow: inset 0 0 0 3px var(--today);
                    }
                    .tvc-cell .daynum {
                        font-size: clamp(15px, 1.6vw, 30px);
                        font-weight: 700;
                        line-height: 1;
                        margin-bottom: .4vh;
                        display: flex;
                        justify-content: flex-end;
                    }
                    .tvc-cell.today .daynum { color: var(--today); }
                    .tvc-cell .daynum .badge {
                        background: var(--today);
                        color: #fff;
                        border-radius: 999px;
                        padding: .2vh .8vw;
                    }

                    .tvc-tasks { display: flex; flex-direction: column; gap: .5vh; overflow: hidden; }
                    .tvc-task {
                        color: #fff;
                        border-radius: 6px;
                        padding: .35vh .6vw;
                        font-size: clamp(12px, 1.15vw, 22px);
                        font-weight: 600;
                        line-height: 1.15;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        display: flex;
                        align-items: center;
                        gap: .4vw;
                    }
                    .tvc-task.done { opacity: .55; text-decoration: line-through; }
                    .tvc-task .check { font-weight: 800; }
                    .tvc-overflow {
                        font-size: clamp(11px, 1vw, 18px);
                        font-weight: 700;
                        color: var(--muted);
                        padding-left: .3vw;
                    }
                    .tvc-empty { display: none; }
                </style>
            </head>
            <body t-attf-class="theme-#{theme}">
                <header class="tvc-header">
                    <div class="tvc-title">
                        <span class="tvc-month" t-esc="month_name"/>
                        <span class="tvc-year" t-esc="year"/>
                        <span class="tvc-board" t-esc="board.name"/>
                    </div>
                    <div class="tvc-legend">
                        <t t-foreach="legend" t-as="lg">
                            <div class="item">
                                <span class="dot" t-attf-style="background:#{lg['color']}"/>
                                <span t-esc="lg['label']"/>
                                <span class="cnt" t-esc="lg['count']"/>
                            </div>
                        </t>
                        <span class="tvc-clock" id="tvc-clock" t-esc="now_label"/>
                    </div>
                </header>

                <div class="tvc-weekdays" t-attf-style="grid-template-columns: repeat(#{num_columns}, 1fr);">
                    <t t-foreach="weekday_names" t-as="wd">
                        <div class="wd" t-esc="wd"/>
                    </t>
                </div>

                <div class="tvc-grid"
                     t-attf-style="grid-template-columns: repeat(#{num_columns}, 1fr); grid-template-rows: repeat(#{len(weeks)}, 1fr);">
                    <t t-foreach="weeks" t-as="week">
                        <t t-foreach="week" t-as="day">
                            <div t-attf-class="tvc-cell#{' out' if not day['in_month'] else ''}#{' today' if day['is_today'] else ''}#{' weekend' if day['is_weekend'] else ''}">
                                <div class="daynum">
                                    <t t-if="day['is_today']">
                                        <span class="badge" t-esc="day['day_num']"/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="day['day_num']"/>
                                    </t>
                                </div>
                                <div class="tvc-tasks">
                                    <t t-foreach="day['tasks']" t-as="task">
                                        <div t-attf-class="tvc-task#{' done' if task['done'] else ''}"
                                             t-attf-style="background:#{task['color']}"
                                             t-att-title="task['name']">
                                            <t t-if="task['done']"><span class="check">&#10003;</span></t>
                                            <span t-esc="task['name']"/>
                                        </div>
                                    </t>
                                    <t t-if="day['overflow']">
                                        <div class="tvc-overflow">+<t t-esc="day['overflow']"/> mas</div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>

                <script type="text/javascript">
                    (function () {
                        var el = document.getElementById('tvc-clock');
                        if (!el) { return; }
                        function pad(n) { return (n &lt; 10 ? '0' : '') + n; }
                        function tick() {
                            var d = new Date();
                            el.textContent = pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' +
                                d.getFullYear() + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
                        }
                        tick();
                        setInterval(tick, 15000);
                    })();
                </script>
            </body>
        </html>
    </template>
</odoo>
