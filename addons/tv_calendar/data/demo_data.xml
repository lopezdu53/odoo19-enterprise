<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Tablero por defecto, listo para proyectar en cuanto se instala.
         Las tareas las crean los usuarios desde Calendario TV > Tareas. -->
    <record id="board_default" model="tv.calendar.board">
        <field name="name">Cronograma Principal</field>
        <field name="theme">light</field>
        <field name="week_start">0</field>
        <field name="show_weekends" eval="True"/>
        <field name="refresh_interval">300</field>
    </record>
</odoo>
