<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tv_calendar_board_list" model="ir.ui.view">
        <field name="name">tv.calendar.board.list</field>
        <field name="model">tv.calendar.board</field>
        <field name="arch" type="xml">
            <list string="Tableros TV">
                <field name="name"/>
                <field name="template_type"/>
                <field name="task_count" string="Tareas"/>
                <field name="refresh_interval"/>
                <field name="theme"/>
            </list>
        </field>
    </record>

    <record id="view_tv_calendar_board_form" model="ir.ui.view">
        <field name="name">tv.calendar.board.form</field>
        <field name="model">tv.calendar.board</field>
        <field name="arch" type="xml">
            <form string="Tablero TV">
                <header>
                    <button name="action_open_kiosk" type="object" string="Abrir en el TV"
                            class="btn-primary" icon="fa-television"/>
                    <button name="action_regenerate_token" type="object"
                            string="Regenerar URL"
                            confirm="Se invalidara la URL actual del TV. Tendras que volver a abrirla en la pantalla. Continuar?"
                            icon="fa-refresh"/>
                    <button name="action_load_standard_schedule" type="object"
                            string="Cargar horario estandar" icon="fa-clock-o"
                            invisible="template_type not in ('operator', 'mecanizado', 'electric', 'component_orders')"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                invisible="template_type not in ('schedule', 'extended')">
                            <field name="task_count" widget="statinfo" string="Tareas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej: Cronograma Produccion"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="template_type"/>
                            <field name="theme"/>
                            <field name="tz"/>
                            <field name="refresh_interval"
                                   invisible="template_type == 'ad'"/>
                        </group>
                        <group string="Acceso del TV">
                            <field name="kiosk_url" widget="CopyClipboardChar"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <!-- Apagado programado de la pantalla (app APK) -->
                    <group string="Apagado programado de la pantalla (app)">
                        <field name="power_schedule_enabled"/>
                        <field name="power_on_time" widget="float_time"
                               invisible="not power_schedule_enabled"/>
                        <field name="power_off_time" widget="float_time"
                               invisible="not power_schedule_enabled"/>
                        <field name="power_weekend_off"
                               invisible="not power_schedule_enabled"/>
                        <div colspan="2" class="text-muted"
                             invisible="not power_schedule_enabled">
                            La app pone la pantalla en negro fuera de este horario (lunes a
                            viernes) y la reactiva sola. No apaga el equipo, solo la imagen.
                        </div>
                    </group>

                    <!-- Cronograma principal -->
                    <group string="Opciones del calendario"
                           invisible="template_type != 'schedule'">
                        <field name="schedule_range"/>
                        <field name="week_start" invisible="schedule_range != 'month'"/>
                        <field name="show_weekends"/>
                    </group>

                    <!-- Operario -->
                    <group invisible="template_type not in ('operator', 'mecanizado', 'electric', 'component_orders')">
                        <group string="Operario">
                            <field name="employee_id"/>
                            <field name="operator_name"/>
                            <field name="task_board_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Mensajes de seguridad">
                            <field name="epp_message"/>
                            <field name="epp_message2"/>
                        </group>
                        <group string="Avisos (horas extra / cambios)" colspan="2">
                            <field name="notice_message" nolabel="1"
                                   placeholder="Ej: Hoy pausa activa a las 9:45. Horas extra hasta las 6:00 pm."/>
                        </group>
                    </group>
                    <group string="Horario del turno"
                           invisible="template_type not in ('operator', 'mecanizado', 'electric', 'component_orders')">
                        <field name="time_slot_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="time_label"/>
                                <field name="activity"/>
                            </list>
                        </field>
                    </group>

                    <!-- Electricos con Inventario -->
                    <group string="Inventario (categorias que puede solicitar el operario)"
                           invisible="template_type != 'electric'">
                        <field name="category_ids" widget="many2many_tags" nolabel="1"
                               options="{'no_create': True}"/>
                    </group>

                    <!-- Ventas (CRM) -->
                    <group string="Ventas: etapas del CRM (opcional)"
                           invisible="template_type != 'ventas'">
                        <field name="crm_stage_new_id" options="{'no_create': True}"/>
                        <field name="crm_stage_proposal_id" options="{'no_create': True}"/>
                        <field name="crm_stage_negotiation_id" options="{'no_create': True}"/>
                        <div colspan="2" class="text-muted">
                            Si dejas las etapas vacias, se buscan por nombre
                            (Nuevos / Propuesta / Negociacion).
                        </div>
                    </group>

                    <!-- Pedidos de Componentes -->
                    <group string="Origen de solicitudes"
                           invisible="template_type != 'component_orders'">
                        <field name="component_source_board_id"
                               options="{'no_create': True}"
                               domain="[('template_type', '=', 'electric')]"/>
                    </group>

                    <!-- Publicidad -->
                    <group string="Publicidad (YouTube)"
                           invisible="template_type != 'ad'">
                        <field name="youtube_url"
                               placeholder="https://www.youtube.com/playlist?list=PLxxxxxxxx"/>
                    </group>

                    <div class="alert alert-info" role="alert">
                        Abre la URL del TV en el navegador de la pantalla (modo pantalla
                        completa). No pide inicio de sesion: cualquiera con la URL puede
                        verla, por eso el enlace lleva un token secreto. Usa
                        <b>Regenerar URL</b> si el enlace se filtra.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tv_calendar_board" model="ir.actions.act_window">
        <field name="name">Tableros TV</field>
        <field name="res_model">tv.calendar.board</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primer tablero</p>
            <p>Un tablero es una pantalla de TV. Cada uno tiene su propia URL para proyectar.</p>
        </field>
    </record>
</odoo>
