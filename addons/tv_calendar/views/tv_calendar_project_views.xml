<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tv_calendar_project_list" model="ir.ui.view">
        <field name="name">tv.calendar.project.list</field>
        <field name="model">tv.calendar.project</field>
        <field name="arch" type="xml">
            <list string="Proyectos" decoration-muted="done">
                <field name="delivery_date"/>
                <field name="client"/>
                <field name="order_ref"/>
                <field name="order_date" optional="show"/>
                <field name="machines" optional="hide"/>
                <field name="board_ids" widget="many2many_tags"/>
                <field name="importance" widget="badge"
                       decoration-danger="importance == 'critical'"
                       decoration-warning="importance == 'high'"
                       decoration-info="importance == 'normal'"
                       decoration-success="importance == 'low'"/>
                <field name="done" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_tv_calendar_project_form" model="ir.ui.view">
        <field name="name">tv.calendar.project.form</field>
        <field name="model">tv.calendar.project</field>
        <field name="arch" type="xml">
            <form string="Proyecto por entregar">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-tasks" disabled="1">
                            <field name="task_count" widget="statinfo" string="Tareas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="client"/>
                        <h1><field name="client" placeholder="Nombre del cliente"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_ref"/>
                            <field name="order_date"/>
                            <field name="delivery_date"/>
                        </group>
                        <group>
                            <field name="board_ids" widget="many2many_tags"
                                   options="{'no_quick_create': True}"/>
                            <field name="importance"/>
                            <field name="done"/>
                        </group>
                    </group>
                    <group string="Maquinas a entregar">
                        <field name="machines" nolabel="1"
                               placeholder="Lista de maquinas / equipos a entregar..."/>
                    </group>
                    <notebook>
                        <page string="1. Pedidos Nac./Int.">
                            <field name="tasks_pedidos">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="board_ids" widget="many2many_tags" options="{'no_quick_create': True}"/>
                                    <field name="date"/>
                                    <field name="importance"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="2. Soldadura">
                            <field name="tasks_soldadura">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="board_ids" widget="many2many_tags" options="{'no_quick_create': True}"/>
                                    <field name="date"/>
                                    <field name="importance"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="3. Torno">
                            <field name="tasks_torno">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="board_ids" widget="many2many_tags" options="{'no_quick_create': True}"/>
                                    <field name="date"/>
                                    <field name="importance"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="4. Control y Automatizacion">
                            <field name="tasks_control">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="board_ids" widget="many2many_tags" options="{'no_quick_create': True}"/>
                                    <field name="date"/>
                                    <field name="importance"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="5. Armado">
                            <field name="tasks_armado">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="board_ids" widget="many2many_tags" options="{'no_quick_create': True}"/>
                                    <field name="date"/>
                                    <field name="importance"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="6. Pruebas FAT">
                            <field name="tasks_fat">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="board_ids" widget="many2many_tags" options="{'no_quick_create': True}"/>
                                    <field name="date"/>
                                    <field name="importance"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="7. Logistica de Despacho">
                            <field name="tasks_logistica">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="board_ids" widget="many2many_tags" options="{'no_quick_create': True}"/>
                                    <field name="date"/>
                                    <field name="importance"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="8. Instalacion y Capacitacion">
                            <field name="tasks_instalacion">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="board_ids" widget="many2many_tags" options="{'no_quick_create': True}"/>
                                    <field name="date"/>
                                    <field name="importance"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tv_calendar_project_calendar" model="ir.ui.view">
        <field name="name">tv.calendar.project.calendar</field>
        <field name="model">tv.calendar.project</field>
        <field name="arch" type="xml">
            <calendar string="Entregas" date_start="delivery_date" color="importance" mode="month">
                <field name="client"/>
                <field name="importance" filters="1"/>
                <field name="board_ids"/>
            </calendar>
        </field>
    </record>

    <record id="view_tv_calendar_project_search" model="ir.ui.view">
        <field name="name">tv.calendar.project.search</field>
        <field name="model">tv.calendar.project</field>
        <field name="arch" type="xml">
            <search string="Buscar proyectos">
                <field name="client"/>
                <field name="order_ref"/>
                <field name="board_ids"/>
                <filter name="pending" string="Por entregar" domain="[('done', '=', False)]"/>
                <filter name="delivered" string="Entregados" domain="[('done', '=', True)]"/>
                <filter name="group_board" string="Tablero" context="{'group_by': 'board_ids'}"/>
                <filter name="group_delivery" string="Fecha de entrega" context="{'group_by': 'delivery_date'}"/>
            </search>
        </field>
    </record>

    <record id="action_tv_calendar_project" model="ir.actions.act_window">
        <field name="name">Proyectos por entregar</field>
        <field name="res_model">tv.calendar.project</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_tv_calendar_project_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra tu primer proyecto</p>
            <p>Los proyectos aparecen en el TV (plantilla Proyectos) ubicados por su fecha de entrega.</p>
        </field>
    </record>

    <menuitem id="menu_tv_calendar_projects" name="Proyectos por entregar"
              parent="menu_tv_calendar_root"
              action="action_tv_calendar_project" sequence="15"/>
</odoo>
