<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tv_calendar_component_list" model="ir.ui.view">
        <field name="name">tv.calendar.component.request.list</field>
        <field name="model">tv.calendar.component.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de componentes" decoration-success="state == 'delivered'"
                  decoration-warning="state == 'requested'">
                <field name="create_date" string="Solicitado"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <field name="value"/>
                <field name="operator"/>
                <field name="board_id"/>
                <field name="requested_datetime" optional="show"/>
                <field name="delivered_datetime" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'delivered'"
                       decoration-warning="state == 'requested'"
                       decoration-info="state == 'new'"/>
            </list>
        </field>
    </record>

    <record id="view_tv_calendar_component_form" model="ir.ui.view">
        <field name="name">tv.calendar.component.request.form</field>
        <field name="model">tv.calendar.component.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de componente">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="product_id"/>
                            <field name="value"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="board_id"/>
                            <field name="task_id"/>
                            <field name="operator"/>
                            <field name="state"/>
                            <field name="requested_datetime"/>
                            <field name="delivered_datetime"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tv_calendar_component_search" model="ir.ui.view">
        <field name="name">tv.calendar.component.request.search</field>
        <field name="model">tv.calendar.component.request</field>
        <field name="arch" type="xml">
            <search string="Buscar solicitudes">
                <field name="name"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <field name="board_id"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'new')]"/>
                <filter name="requested" string="Solicitados" domain="[('state', '=', 'requested')]"/>
                <filter name="delivered" string="Entregados" domain="[('state', '=', 'delivered')]"/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_board" string="Tablero" context="{'group_by': 'board_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_tv_calendar_component" model="ir.actions.act_window">
        <field name="name">Solicitudes de componentes</field>
        <field name="res_model">tv.calendar.component.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tv_calendar_component_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aun no hay solicitudes</p>
            <p>Las solicitudes que crean los operarios desde el TV de Electricos apareceran aqui.</p>
        </field>
    </record>

    <menuitem id="menu_tv_calendar_components" name="Solicitudes de Componentes"
              parent="menu_tv_calendar_root"
              action="action_tv_calendar_component" sequence="18"/>
</odoo>
