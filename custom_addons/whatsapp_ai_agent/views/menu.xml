<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menú de nivel superior dentro de la app WhatsApp.
         Intentamos con el ID más común; si falla el módulo igual instala
         y los menús quedan accesibles desde Ajustes > Técnico. -->

    <!-- Menú raíz propio para máxima compatibilidad -->
    <menuitem id="menu_whatsapp_ai_root_main"
              name="WhatsApp AI Agent"
              sequence="90"
              web_icon="whatsapp_ai_agent,static/description/icon.png"
              groups="base.group_user"/>

    <menuitem id="menu_whatsapp_ai_agents"
              name="Agentes AI"
              parent="menu_whatsapp_ai_root_main"
              action="action_whatsapp_ai_agent"
              sequence="10"/>

    <menuitem id="menu_whatsapp_ai_sessions"
              name="Conversaciones"
              parent="menu_whatsapp_ai_root_main"
              action="action_whatsapp_ai_session"
              sequence="20"/>

</odoo>
